trackConn(RunService.Heartbeat:Connect(function()
    if LIVE.unloaded or not CFG.AirStrafeEnabled then return end
    local char,hrp,hum=myChar(); if not char then return end
    if hum:GetState()==Enum.HumanoidStateType.Freefall then
