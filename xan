local CFG_FILE = "xanax_xyz.json"
local function saveCfg()
    if not writefile then return end
    pcall(function()
        local save = {}
        for k,v in pairs(CFG) do
            local t=typeof(v)
            if t=="number" or t=="string" or t=="boolean" or t=="table" then save[k]=v
            elseif t=="EnumItem" then save[k]={__enum=true, type=tostring(v.EnumType), name=v.Name} end
        end
        writefile(CFG_FILE, HttpService:JSONEncode(save))
    end)
end
local function loadCfg()
    if not (readfile and isfile and isfile(CFG_FILE)) then return end
    pcall(function()
        local data = HttpService:JSONDecode(readfile(CFG_FILE))
        for k,v in pairs(data) do
            if CFG[k] ~= nil then
                if typeof(v)=="table" and v.__enum and typeof(CFG[k])=="EnumItem" then
                    local okE, enum = pcall(function()
                        local parts = {}
                        for part in string.gmatch(v.type, "[^%.]+") do table.insert(parts, part) end
                        local cur = Enum
                        for i=2,#parts do cur = cur[parts[i]] end
                        return cur[v.name]
                    end)
                    if okE and enum then CFG[k]=enum end
                elseif typeof(CFG[k]) == typeof(v) then
                    CFG[k]=v
                end
            end
        end
    end)
end
