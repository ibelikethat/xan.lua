local function activeSilentPos()
    if not silentActive() then return nil end
    local _, pos = getSilentTarget()
    return pos
end
local function activeAimOrSilentPos()
    local pos = activeSilentPos()
    if pos then return pos end
    if aimbotActive() then
        local _, p2 = getAimbotTarget()
        return p2
    end
    return nil
end
local function redirectDir(origin, direction, aimPos)
    local len = typeof(direction)=="Vector3" and direction.Magnitude or 1000
    if len < 1e-3 then len = 1000 end
    local nd = aimPos - origin
    if nd.Magnitude < 1e-3 then return direction end
    return nd.Unit * len
end
local function wallbangParams(oldP)
    if not CFG.WallbangEnabled then return oldP end
    local p2 = RaycastParams.new()
    p2.FilterType = Enum.RaycastFilterType.Exclude
    p2.FilterDescendantsInstances = { LP.Character, Camera }
    p2.IgnoreWater = true
    return p2
end

if hookmetamethod then
    local oldNC
    oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if not LIVE.unloaded and not checkcaller() then
            local aimPos = activeAimOrSilentPos()
            if aimPos then
                local m = getnamecallmethod()
                if self == Workspace or self == workspace then
                    if m == "Raycast" or m == "Blockcast" or m == "Spherecast" or m == "Shapecast" then
                        local a = { ... }; local n = select("#", ...)
                        local origin, dir = a[1], a[2]
                        if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
                            a[2] = redirectDir(origin, dir, aimPos)
                            if typeof(a[3]) == "RaycastParams" then a[3] = wallbangParams(a[3]) end
                            return oldNC(self, table.unpack(a, 1, n))
                        end
                    elseif m == "FindPartOnRay" or m == "FindPartOnRayWithIgnoreList" or m == "FindPartOnRayWithWhitelist" then
                        local a = { ... }; local n = select("#", ...)
                        local ray = a[1]
                        if typeof(ray) == "Ray" then
                            local len = ray.Direction.Magnitude; if len < 1e-3 then len = 1000 end
                            a[1] = Ray.new(ray.Origin, (aimPos - ray.Origin).Unit * len)
                            return oldNC(self, table.unpack(a, 1, n))
                        end
                    end
                end
            end
        end
        return oldNC(self, ...)
    end))
    LIVE.hooks.namecall = oldNC
    local oldIdx
    oldIdx = hookmetamethod(game, "__index", newcclosure(function(self, k)
        if not LIVE.unloaded and not checkcaller() and self == Mouse then
            local aimPos = activeAimOrSilentPos()
            if aimPos then
                if k == "Hit" then
                    local origin = Camera.CFrame.Position
                    return CFrame.new(origin, aimPos) + (aimPos - origin)
                elseif k == "Target" then
                    local t = (silentActive() and select(1, getSilentTarget()))
                        or (aimbotActive() and select(1, getAimbotTarget()))
                    return t
                elseif k == "UnitRay" then
                    local o = Camera.CFrame.Position; return Ray.new(o, (aimPos - o).Unit)
                elseif k == "Origin" then
                    return Camera.CFrame.Position
                elseif k == "X" then
                    local sp = worldToScreen(aimPos); return sp.X
                elseif k == "Y" then
                    local sp = worldToScreen(aimPos); return sp.Y
                end
            end
        end
        return oldIdx(self, k)
    end))
    LIVE.hooks.index = oldIdx
end
