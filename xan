local function fullUnload()
    if LIVE.unloaded then return end
    LIVE.unloaded = true
    pcall(saveCfg)
    for _, c in ipairs(LIVE.conns) do pcall(function() c:Disconnect() end) end
    LIVE.conns = {}
    pcall(restoreAll)
    for plr,_ in pairs(espState) do pcall(killEsp, plr) end
    espState = {}
    for _, d in ipairs(LIVE.drawings) do pcall(function() d:Remove() end) end
    LIVE.drawings = {}
    for _, i in ipairs(LIVE.instances) do pcall(function() i:Destroy() end) end
    LIVE.instances = {}
    killFly()
    pcall(function() Window:Destroy() end)
    hbState = {}
    if getgenv then pcall(function() getgenv().XanaxUnload = nil end) end
end

SettingsTab:AddButton({
    Title="Unload", Subtitle="Tear down hooks, drawings, body movers, UI", Risky=true,
    Icon="log-out", Text="Unload",
    Callback=fullUnload,
})

if getgenv then getgenv().XanaxUnload = fullUnload end

