local function visCheck(part, char)
    if CFG.WallbangEnabled then return true end
    local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances={LP.Character, Camera}; rp.IgnoreWater=true
    local origin=Camera.CFrame.Position
    local r=Workspace:Raycast(origin, (part.Position-origin), rp)
    if not r or not r.Instance then return true end
    return r.Instance:IsDescendantOf(char)
end
local function resolverTarget(char, basePart)
    if not CFG.ResolverEnabled then return basePart end
    local head = char:FindFirstChild("Head")
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if head and hrp and basePart == head then
        local hv = head.AssemblyLinearVelocity
        if typeof(hv)=="Vector3" and hv.Magnitude > 180 then return hrp end
        local av = head.AssemblyAngularVelocity
        if typeof(av)=="Vector3" and av.Magnitude > 25 then return hrp end
    end
    return basePart
end
local pingSec = 0
trackConn(RunService.Heartbeat:Connect(function()
    if LIVE.unloaded then return end
    local ok, ms = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and typeof(ms)=="number" then pingSec = ms/1000 end
end))
local function predictPos(part)
    if not CFG.PredictionEnabled then return part.Position end
    local vel = part.AssemblyLinearVelocity
    if typeof(vel) ~= "Vector3" then return part.Position end
    local t = CFG.PredictionAmount + pingSec * 0.5
    return part.Position + vel * t
end

local function findTargetBy(partName, fov, wallcheck, allowRootFallback)
    local best,bestScore,bestPos,bestChar
    local center=Camera.ViewportSize/2
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr~=LP and not isFriend(plr) then
            local char=alive(plr)
            if char then
                local part = pickTargetPart(char, partName, allowRootFallback)
                if part then
                    part = resolverTarget(char, part)
                    local predicted = predictPos(part)
                    local sp, on = worldToScreen(predicted)
                    if on then
                        local d = (sp - center).Magnitude
                        if d <= fov then
                            local okVis = true
                            if wallcheck then okVis = visCheck(part, char) end
                            if okVis and (not bestScore or d < bestScore) then
                                best, bestScore, bestPos, bestChar = part, d, predicted, char
                            end
                        end
                    end
                end
            end
        end
    end
    return best, bestPos, bestChar
end
local function getSilentTarget() return findTargetBy(CFG.SilentPart, CFG.SilentFOV, CFG.SilentWallcheck, CFG.SilentFallbackRoot) end
local function getAimbotTarget() return findTargetBy(CFG.AimbotPart, CFG.AimbotFOV, CFG.AimbotWallcheck, true) end

