local hbState = {}
local function captureOrig(part)
    return { Size=part.Size, Transparency=part.Transparency, Material=part.Material,
             CanCollide=part.CanCollide, Massless=part.Massless, Color=part.Color }
end
local function restorePart(record)
    if not record then return end
    local part = record.part
    if part and part.Parent then
        pcall(function()
            part.Size=record.orig.Size; part.Transparency=record.orig.Transparency
            part.Material=record.orig.Material; part.CanCollide=record.orig.CanCollide
            part.Massless=record.orig.Massless; part.Color=record.orig.Color
        end)
    end
end
local function restoreAll() for p,rec in pairs(hbState) do restorePart(rec); hbState[p]=nil end end
local function restoreOne(plr) local rec=hbState[plr]; if rec then restorePart(rec); hbState[plr]=nil end end
local function applyHitbox(plr)
    local char = alive(plr); if not char then return end
    local target = char:FindFirstChild(CFG.HitboxPart) or char:FindFirstChild("HumanoidRootPart")
    if not target or not target:IsA("BasePart") then return end
    if not CFG.HitboxIgnoreDist and distToPart(target) > CFG.HitboxMaxDist then restoreOne(plr); return end
    local rec = hbState[plr]
    if not rec or rec.part ~= target then
        if rec then restorePart(rec) end
        rec = { part=target, orig=captureOrig(target) }; hbState[plr]=rec
    end
    local sz = math.clamp(CFG.HitboxSize, 1, 50)
    pcall(function()
        target.Size=Vector3.new(sz,sz,sz)
        target.Transparency = CFG.HitboxVisual and CFG.HitboxTrans or 1
        target.Material=Enum.Material.ForceField
        target.CanCollide=false; target.Massless=true
        target.Color=BRAND.Pink
    end)
end
trackConn(RunService.Heartbeat:Connect(function()
    if LIVE.unloaded then return end
    if not CFG.HitboxEnabled then
        if next(hbState) then restoreAll() end; return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if not isFriend(plr) then
            if alive(plr) then pcall(applyHitbox, plr) else restoreOne(plr) end
        end
    end
end))
local function onPlayerAdded(plr)
    trackConn(plr.CharacterAdded:Connect(function() hbState[plr]=nil end))
