----------------------------------------------------------------
-- CUFF LOOT — Xyz PvP remote matrix
-- Dump confirms the loot pipe lives on these ReplicatedStorage remotes:
--   InventoryRequest (RemoteEvent) — client → server inventory ops
--   Interact         (RemoteEvent) — client → server interactions (cuff loot)
--   PickupNotice     (RemoteEvent) — item pickup signal
-- Game uses a custom inventory module (InventoryLogic / CuffLogic), not Roblox Tools.
-- Items are stacked by weapon class — "SNS", "SNSMk2", "SNSPistol", "SNSPistolBasic",
-- "VintagePistol", "Pistol". We fire a wide (verb × arg × item) matrix in one press
-- so stacked AND unstacked items transfer in a single server tick.
----------------------------------------------------------------
local lootLog = {}
local lastLootAt = 0

local function findRemote(name)
    local r = RepStorage:FindFirstChild(name, true)
    if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction") or r:IsA("UnreliableRemoteEvent")) then
        return r
    end
    return nil
end

local lootRemotes = {}
local function rebuildCuffRemotes()
    lootRemotes = {
        InventoryRequest = findRemote("InventoryRequest"),
        Interact         = findRemote("Interact"),
        PickupNotice     = findRemote("PickupNotice"),
        InventorySync    = findRemote("InventorySync"),
    }
end
rebuildCuffRemotes()
trackConn(RepStorage.DescendantAdded:Connect(function(d)
    if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") or d:IsA("UnreliableRemoteEvent") then
        local n = d.Name
        if n=="InventoryRequest" or n=="Interact" or n=="PickupNotice" or n=="InventorySync" then
            rebuildCuffRemotes()
        end
    end
end))

local KNOWN_ITEM_NAMES = {
    "SNS", "SNSMk2", "SNSPistol", "SNSPistolBasic",
    "VintagePistol", "Pistol", "ClassicPistol",
    "Ammo", "AmmoPistol", "Cash", "Money",
}
local VERBS = {
    "Loot", "LootAll", "LootCuffed", "Steal", "StealAll",
    "Take", "TakeAll", "Transfer", "TransferAll",
    "Rob", "Strip", "StripInventory", "Grab", "Pickup",
    "Interact", "RequestLoot", "RequestSteal",
}

local function sendBag(remote, bag)
    if not remote then return 0 end
    local fired = 0
    for _, args in ipairs(bag) do
        pcall(function()
            if remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent") then
                remote:FireServer(table.unpack(args))
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(table.unpack(args))
            end
            fired = fired + 1
        end)
    end
    return fired
end

local function pushLoot(line)
    table.insert(lootLog, 1, line)
    if #lootLog > 60 then table.remove(lootLog) end
end

local function cuffLootMatrix(targetPlr)
    local fired = 0
    local char = targetPlr.Character
    local uid  = targetPlr.UserId
    local name = targetPlr.Name

    -- Interact: cuff pipeline usually lives here. Fire every verb × every subject
    local interactBag = {}
    for _, verb in ipairs(VERBS) do
        table.insert(interactBag, { verb, targetPlr })
        table.insert(interactBag, { verb, name })
        table.insert(interactBag, { verb, uid })
        table.insert(interactBag, { targetPlr, verb })
        table.insert(interactBag, { name, verb })
        if char then
            table.insert(interactBag, { verb, char })
            table.insert(interactBag, { char, verb })
        end
    end
    table.insert(interactBag, { targetPlr })
    table.insert(interactBag, { name })
    table.insert(interactBag, { uid })
    if char then table.insert(interactBag, { char }) end
    fired = fired + sendBag(lootRemotes.Interact, interactBag)

    -- InventoryRequest: stacked + unstacked, per item, with large count
    local invBag = {}
    for _, verb in ipairs(VERBS) do
        -- "take everything from X" generic shapes
        table.insert(invBag, { verb, targetPlr })
        table.insert(invBag, { verb, name })
        table.insert(invBag, { verb, uid })
        table.insert(invBag, { verb, targetPlr, true })
        -- per-item stack strip: verb + target + item + big count
        for _, item in ipairs(KNOWN_ITEM_NAMES) do
            table.insert(invBag, { verb, targetPlr, item, 999 })
            table.insert(invBag, { verb, name, item, 999 })
            table.insert(invBag, { verb, uid, item, 999 })
            table.insert(invBag, { verb, targetPlr, item })
            table.insert(invBag, { item, 999, verb, targetPlr })
        end
    end
    -- bare table form some servers accept: {action=, target=, item=, amount=}
    for _, verb in ipairs(VERBS) do
        for _, item in ipairs(KNOWN_ITEM_NAMES) do
            table.insert(invBag, { { action=verb, target=targetPlr, item=item, amount=999 } })
            table.insert(invBag, { { action=verb, target=name, item=item, amount=999 } })
            table.insert(invBag, { { Action=verb, Target=targetPlr, Item=item, Amount=999 } })
        end
        table.insert(invBag, { { action=verb, target=targetPlr, all=true } })
    end
    fired = fired + sendBag(lootRemotes.InventoryRequest, invBag)

    -- PickupNotice: fire bare target in case server treats it as a cuff-pickup acknowledgement
    if lootRemotes.PickupNotice then
        local pnBag = {}
        for _, verb in ipairs({"Loot","Pickup","Take"}) do
            table.insert(pnBag, { verb, targetPlr })
            table.insert(pnBag, { targetPlr, verb })
        end
        fired = fired + sendBag(lootRemotes.PickupNotice, pnBag)
    end

    -- InventorySync nudge (server may push updated inventory back if we hit)
    if lootRemotes.InventorySync then
        pcall(function()
            if lootRemotes.InventorySync:IsA("RemoteEvent") then
                lootRemotes.InventorySync:FireServer()
                lootRemotes.InventorySync:FireServer(targetPlr)
            end
        end)
    end

    return fired
end

local function closestLootableEnemy()
    local char, myHrp = myChar(); if not char then return nil end
    local best, bestD
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and not isFriend(p) then
            local pc, phrp = alive(p)
            if pc and phrp then
                local d = (phrp.Position - myHrp.Position).Magnitude
                if d <= CFG.LootRange and (not bestD or d < bestD) then
                    best, bestD = p, d
                end
            end
        end
    end
    return best, bestD
end

local Window

local function doLootKey()
    if LIVE.unloaded then return end
    local now = tick()
    if now - lastLootAt < CFG.LootCooldown then return end
    lastLootAt = now

    local target, dist = closestLootableEnemy()
    if not target then
        if CFG.LootNotify and Window then
            Window:Notify({ Title=BRAND.Name, Text="no cuff in "..CFG.LootRange.."s", Icon="package", Duration=2.5 })
        end
        return
    end

    local fired = 0
    if CFG.LootUseRemote then fired = cuffLootMatrix(target) or 0 end

    local line = string.format("[%s] stripped %s @ %dm — %d calls fired across %s/%s/%s",
        os.date("%H:%M:%S"), target.DisplayName, math.floor(dist or 0), fired,
        lootRemotes.Interact and "Interact" or "·",
        lootRemotes.InventoryRequest and "InventoryRequest" or "·",
        lootRemotes.PickupNotice and "PickupNotice" or "·")
    pushLoot(line)

    if CFG.LootNotify and Window then
        Window:Notify({
            Title=BRAND.Name,
            Text=string.format("stripped %s (%dm) — %d calls", target.DisplayName, math.floor(dist or 0), fired),
            Icon="package", Duration=3
        })
    end
end

trackConn(UserInputService.InputBegan:Connect(function(i, gp)
    if gp or LIVE.unloaded then return end
    if typeof(CFG.LootKey)=="EnumItem" and i.KeyCode == CFG.LootKey then
        doLootKey()
    end
end))

