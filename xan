local flyVel, flyGyro
local function killFly()
    if flyVel then pcall(function() flyVel:Destroy() end); flyVel=nil end
    if flyGyro then pcall(function() flyGyro:Destroy() end); flyGyro=nil end
end
local function ensureFly(hrp)
    if not flyVel or flyVel.Parent ~= hrp then
        killFly()
        flyVel=Instance.new("BodyVelocity")
        flyVel.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
        flyVel.Velocity=Vector3.zero; flyVel.Parent=hrp; trackInst(flyVel)
        flyGyro=Instance.new("BodyGyro")
        flyGyro.MaxTorque=Vector3.new(math.huge,math.huge,math.huge)
        flyGyro.P=9000; flyGyro.D=500
        flyGyro.CFrame=hrp.CFrame; flyGyro.Parent=hrp; trackInst(flyGyro)
    end
end
trackConn(LP.CharacterAdded:Connect(function() killFly() end))
trackConn(RunService.Heartbeat:Connect(function()
    if LIVE.unloaded then return end
    local char,hrp,hum=myChar(); if not char then killFly(); return end
    if CFG.FlyEnabled then
        ensureFly(hrp)
        local look=Camera.CFrame.LookVector; local right=Camera.CFrame.RightVector
        local dir=Vector3.zero
        if inputStates.W then dir=dir+look end
        if inputStates.S then dir=dir-look end
        if inputStates.A then dir=dir-right end
        if inputStates.D then dir=dir+right end
        if inputStates.Space then dir=dir+Vector3.new(0,1,0) end
        if inputStates.Shift then dir=dir-Vector3.new(0,1,0) end
        if dir.Magnitude>0 then dir=dir.Unit*CFG.FlySpeed else dir=Vector3.zero end
        flyVel.Velocity=dir; flyGyro.CFrame=Camera.CFrame; hum.PlatformStand=false
    else killFly() end
end))

local orbitAngle, orbitTargetPlr = 0, nil
local function pickClosestEnemy()
    local char, myHrp = myChar(); if not char then return nil end
    local best, bestD
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and not isFriend(p) then
            local pc, phrp = alive(p)
            if pc and phrp then
                local d = (phrp.Position - myHrp.Position).Magnitude
                if d <= CFG.OrbitMaxGrabDist and (not bestD or d < bestD) then
                    best, bestD = p, d
                end
            end
        end
    end
    return best
end
local function startOrbit() local t=pickClosestEnemy(); if t then orbitTargetPlr=t; CFG.OrbitEnabled=true else CFG.OrbitEnabled=false end end
local function stopOrbit() orbitTargetPlr=nil; CFG.OrbitEnabled=false end
trackConn(RunService.Heartbeat:Connect(function(dt)
    if LIVE.unloaded or not CFG.OrbitEnabled or not orbitTargetPlr then return end
    local char, hrp = myChar(); if not char then return end
    local tc, thrp = alive(orbitTargetPlr); if not tc then stopOrbit(); return end
    orbitAngle = (orbitAngle + CFG.OrbitSpeed * dt) % 360
    local rad = math.rad(orbitAngle)
    local offset = Vector3.new(math.cos(rad), 0, math.sin(rad)) * CFG.OrbitRadius
    local goal = thrp.Position + offset + Vector3.new(0, CFG.OrbitHeight, 0)
    pcall(function() hrp.CFrame = CFrame.new(goal, thrp.Position) end)
end))

local spinAngle, jitterToggle = 0, false
trackConn(RunService.Heartbeat:Connect(function(dt)
    if LIVE.unloaded then return end
    local char,hrp=myChar(); if not char then return end
    if CFG.SpinEnabled then
        spinAngle=(spinAngle+CFG.SpinSpeed*dt*60)%360
        pcall(function() hrp.CFrame=CFrame.new(hrp.Position)*CFrame.Angles(0,math.rad(spinAngle),0) end)
    elseif CFG.AntiAimEnabled then
        local y=0; local look=Camera.CFrame.LookVector
        local base=math.atan2(-look.X,-look.Z)
        if CFG.AntiAimMode=="Backwards" then y=base+math.pi
        elseif CFG.AntiAimMode=="Jitter" then jitterToggle=not jitterToggle
            y=base+(jitterToggle and math.pi*0.75 or -math.pi*0.75)
        elseif CFG.AntiAimMode=="Spin" then spinAngle=(spinAngle+30*dt*60)%360; y=math.rad(spinAngle)
        elseif CFG.AntiAimMode=="Random" then y=base+math.random()*math.pi*2 end
        pcall(function() hrp.CFrame=CFrame.new(hrp.Position)*CFrame.Angles(0,y,0) end)
    end
end))
local peekDir,peekTimer=1,0
