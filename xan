local function silentActive() if not CFG.SilentEnabled or LIVE.unloaded then return false end
    if CFG.SilentHoldRMB then return silentHeld end; return true end
local function aimbotActive() if not CFG.AimbotEnabled or LIVE.unloaded then return false end
