local function drawOffscreenArrow(s, screenPos)
    local vp=Camera.ViewportSize; local cx,cy=vp.X/2,vp.Y/2
    local dx,dy=screenPos.X-cx,screenPos.Y-cy
    local len=math.sqrt(dx*dx+dy*dy); if len<1 then len=1 end
    local nx,ny=dx/len,dy/len; local r=math.min(vp.X,vp.Y)*0.35
    local tip=Vector2.new(cx+nx*r,cy+ny*r)
    local px,py=-ny,nx; local sz=12
    local bL=Vector2.new(tip.X-nx*sz+px*sz*0.6,tip.Y-ny*sz+py*sz*0.6)
    local bR=Vector2.new(tip.X-nx*sz-px*sz*0.6,tip.Y-ny*sz-py*sz*0.6)
    s.arrA.From,s.arrA.To,s.arrA.Visible=tip,bL,true
    s.arrB.From,s.arrB.To,s.arrB.Visible=tip,bR,true
    s.arrC.From,s.arrC.To,s.arrC.Visible=bL,bR,true
end
local function hideArrow(s) s.arrA.Visible,s.arrB.Visible,s.arrC.Visible=false,false,false end
local function updateEspFor(plr)
    if not hasDrawing then return end
    if not espState[plr] then mkEsp(plr) end
    local s=espState[plr]; if not s then return end
    if not CFG.ESPEnabled or isFriend(plr) then hideEsp(s); return end
    local char,hrp,hum=alive(plr); if not char then hideEsp(s); return end
    local head=char:FindFirstChild("Head") or hrp
    local dist=(Camera.CFrame.Position-hrp.Position).Magnitude
    if dist>CFG.ESPMaxDist then hideEsp(s); return end
    local top,onT=worldToScreen(head.Position+Vector3.new(0,0.6,0))
    local bot,onB=worldToScreen(hrp.Position-Vector3.new(0,3,0))
    local cs=worldToScreen(hrp.Position)
    if not (onT and onB) then
        for k,v in pairs(s) do
            if k~="arrA" and k~="arrB" and k~="arrC" then pcall(function() v.Visible=false end) end
        end
        if CFG.ESPArrows then drawOffscreenArrow(s,cs) else hideArrow(s) end
        return
    end
    hideArrow(s)
    local h=math.abs(bot.Y-top.Y); local w=h*0.5
    local pos=Vector2.new(top.X-w/2,top.Y)
    s.box.Size,s.box.Position,s.box.Visible=Vector2.new(w,h),pos,true
    s.boxOut.Size,s.boxOut.Position,s.boxOut.Visible=s.box.Size,s.box.Position,true
    if CFG.ESPGlow then
        s.glow.Size,s.glow.Position,s.glow.Visible=Vector2.new(w+4,h+4),Vector2.new(pos.X-2,pos.Y-2),true
    else s.glow.Visible=false end
    if CFG.ESPCorners then
        local cl=math.min(h,w)*0.22
        local x1,y1,x2,y2=pos.X,pos.Y,pos.X+w,pos.Y+h
        s.c1a.From,s.c1a.To,s.c1a.Visible=Vector2.new(x1,y1),Vector2.new(x1+cl,y1),true
        s.c1b.From,s.c1b.To,s.c1b.Visible=Vector2.new(x1,y1),Vector2.new(x1,y1+cl),true
        s.c2a.From,s.c2a.To,s.c2a.Visible=Vector2.new(x2,y1),Vector2.new(x2-cl,y1),true
        s.c2b.From,s.c2b.To,s.c2b.Visible=Vector2.new(x2,y1),Vector2.new(x2,y1+cl),true
        s.c3a.From,s.c3a.To,s.c3a.Visible=Vector2.new(x1,y2),Vector2.new(x1+cl,y2),true
        s.c3b.From,s.c3b.To,s.c3b.Visible=Vector2.new(x1,y2),Vector2.new(x1,y2-cl),true
        s.c4a.From,s.c4a.To,s.c4a.Visible=Vector2.new(x2,y2),Vector2.new(x2-cl,y2),true
        s.c4b.From,s.c4b.To,s.c4b.Visible=Vector2.new(x2,y2),Vector2.new(x2,y2-cl),true
    else
        for _,k in ipairs({"c1a","c1b","c2a","c2b","c3a","c3b","c4a","c4b"}) do s[k].Visible=false end
    end
    if CFG.ESPNames then
        s.name.Text,s.name.Position,s.name.Visible=plr.DisplayName,Vector2.new(top.X,top.Y-18),true
        s.dist.Text,s.dist.Position,s.dist.Visible=string.format("%dm",math.floor(dist)),Vector2.new(top.X,bot.Y+2),true
    else s.name.Visible,s.dist.Visible=false,false end
    if CFG.ESPHealthBar then
        local ratio=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
        local hpH=h*ratio; local bgX=pos.X-7
        s.hpBg.Position,s.hpBg.Size,s.hpBg.Visible=Vector2.new(bgX,pos.Y),Vector2.new(4,h),true
        s.hpBar.Position,s.hpBar.Size,s.hpBar.Visible=Vector2.new(bgX+1,pos.Y+(h-hpH)+1),Vector2.new(2,math.max(hpH-2,0)),true
        s.hpBar.Color=Color3.fromHSV(ratio*0.33,0.85,1)
    else s.hpBg.Visible,s.hpBar.Visible=false,false end
    if CFG.ESPTracers then
        s.tracer.From=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y)
        s.tracer.To,s.tracer.Visible=Vector2.new(top.X,bot.Y),true
    else s.tracer.Visible=false end
end
