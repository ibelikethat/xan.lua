trackConn(RunService.RenderStepped:Connect(function(dt)
    if LIVE.unloaded or not aimbotActive() then return end
    local t, aimPos = getAimbotTarget(); if not t or not aimPos then return end
    local desired = CFrame.new(Camera.CFrame.Position, aimPos)
    local s = math.clamp(CFG.AimbotSmooth, 0, 1)
    if s <= 0.015 then
        Camera.CFrame = desired
    else
        local k = 2 + (1 - s) * 38
        local alpha = 1 - math.exp(-k * dt)
        Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(alpha, 0, 1))
    end
end))

